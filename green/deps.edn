;; Green and ONCE move together. ONCE 38e3cd6 trusts the SDK's step error
;; alone when it reads state (its `read-state` no longer catches
;; java.io.IOException), so it needs green 3f33f5d, which reports a tofu launch
;; failure — a missing stage directory or binary — as exit 127 and thus as its
;; own `tofu output failed:` ex-info. An older green under this ONCE would crash
;; a fresh-clone create instead of reporting its credentials.
{:paths ["src/clj" "src/resources"]
 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        io.github.getcolors/green {:git/url "https://github.com/getcolors/green.git"
                                   :git/sha "3f33f5d4dcce1f8d97a11b6972e13eb3f0b37654"}
        io.github.getcolors/once  {:git/url "https://github.com/getcolors/once.git"
                                   :git/sha "38e3cd66674a32fb96605e1b17ae6791086ad5c1"
                                   :deps/root "green"}}
 :aliases {:dev {:extra-paths ["test/clj" "test/resources"]}
           :test {:extra-paths ["test/clj" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
